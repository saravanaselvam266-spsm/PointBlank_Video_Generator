# ==============================================================================
# PointBlank AI Video Studio — Git Ignore Specification
# ==============================================================================

# Environment Secrets & Configuration
.env
.env.*
*.env
!.env.example
backend/.env
backend/.env.*
frontend/.env
frontend/.env.*

# API Keys & Certificates
*.pem
*.key
*.cert
*.crt
*.p12
*.pfx

# Python / Virtual Environment & Caches
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.venv/
ENV/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/

# Node / Frontend Dependencies & Builds
node_modules/
frontend/node_modules/
frontend/dist/
frontend/dist-ssr/
.astro/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Uploaded User Media & Local Video Storage (Private Doctor Photos & Rendered Videos)
backend/uploads/original_photos/*
!backend/uploads/original_photos/.gitkeep
backend/uploads/videos/*
!backend/uploads/videos/.gitkeep
backend/storage/*
!backend/storage/.gitkeep
storage/
uploads/

# Database Files
*.db
*.sqlite
*.sqlite3

# Temporary & Scratch Files
scratch/
tmp/
temp/
*.tmp
*.log

# IDE & Editor Files
.vscode/*
!.vscode/extensions.json
.idea/
*.swp
*.swo
*.suo
*.ntvs*
*.njsproj
*.sln

# OS System Files
.DS_Store
Thumbs.db
desktop.ini

# Agent & Brain Artifact Caches
.antigravity/
.gemini/
